  "compilerOptions": { "lib": ["ES2022"], "types": ["node"] },
  "include": [
    "src/main/**/*.ts",
    "src/integrations/**/*.ts",
    "src/experiments/**/*.ts",
    "src/profiles/**/*.ts",
    "src/server/**/*.ts",
